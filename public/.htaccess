# Apache config для SPA на Beget
# Prerender создаёт dist/<route>/index.html для каждого маршрута,
# Apache сам отдаёт их при прямом заходе. Fallback на /index.html — только для несуществующих путей.

Options -MultiViews -Indexes
DirectoryIndex index.html
# Не редиректить /services → /services/ — отдавать dist/services/index.html напрямую,
# чтобы канонические URL без слэша из sitemap не превращались в 301.
DirectorySlash Off

# Кастомная 404 (prerender создаёт dist/404.html с правильными метатегами)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Канонический URL — без завершающего слэша.
  # /services/ → 301 → /services. Корень / не трогаем.
  RewriteCond %{REQUEST_URI} ^.+/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Директория с index.html → внутренняя отдача без редиректа.
  # DirectorySlash Off отключает авто-добавление слэша, из-за чего mod_dir
  # не подхватывает DirectoryIndex для /services и т.п. (давало 403).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]


  # Если запрошен реальный файл или директория — отдать как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Известные системные пути не редиректим
  RewriteRule ^(assets|favicon\.ico|robots\.txt|sitemap\.xml|llms\.txt|og-default\.jpg) - [L]

  # Всё остальное — 404 (Apache отдаст ErrorDocument /404.html со статусом 404).
  # Это правильно для SEO: несуществующий URL должен возвращать HTTP 404, а не 200.
  RewriteRule ^ - [R=404,L]
</IfModule>

# --- Кэширование ---
<IfModule mod_headers.c>
  # HTML — без кэша, чтобы обновления сразу подхватывались
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Хэшированные ассеты — долгий immutable-кэш
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|webp|avif|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # sitemap/robots — короткий кэш
  <FilesMatch "^(sitemap\.xml|robots\.txt|llms\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# --- Сжатие ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Безопасность ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
